# ClauseCatcher environment variables — copy to .env and fill in real values.
# Never commit .env.

ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the default Gemini model used for claim-check.
CLAUSECATCHER_GEMINI_MODEL=

# Spend / abuse guards (defaults shown).
# Max concurrent live call WebSockets.
CLAUSECATCHER_MAX_LIVE_WS=2
# Estimated paid-API budget for the process lifetime, in USD.
CLAUSECATCHER_BUDGET_USD=3
# Kill switch: set to 1 to stop ALL paid API use (AssemblyAI + Gemini).
CLAUSECATCHER_PAID_DISABLED=0
# Hard cap on one live call's length, in seconds.
CLAUSECATCHER_SESSION_CAP_S=420
CLAUSECATCHER_IDLE_TIMEOUT_S=60
# Max claim checks per session.
CLAUSECATCHER_MAX_CHECKS=40
# Max Gemini calls for the process lifetime.
CLAUSECATCHER_MAX_GEMINI_CALLS=300
# Comma-separated browser origins allowed to call the API / open WebSockets,
# e.g. https://clausecatcher.onrender.com (set it on any public deploy).
CLAUSECATCHER_ALLOWED_ORIGINS=

PORT=8000
